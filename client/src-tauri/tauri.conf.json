{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "playTogether",
  "version": "0.1.0",
  "identifier": "com.daoway.playtogether",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "playTogether",
        "width": 520,
        "height": 470,
        "minWidth": 480,
        "minHeight": 440,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.png"
    ]
  }
}
